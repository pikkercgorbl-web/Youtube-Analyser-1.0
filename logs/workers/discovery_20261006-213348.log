2026-10-06 21:41:48,781 INFO sqlalchemy.engine.Engine 
    WITH locked AS (
        SELECT id_units_reserved
        FROM radar_api_budget_daily
        WHERE budget_kind = %(kind)s AND utc_day = %(day)s
        FOR UPDATE
    ),
    grant_calc AS (
        SELECT LEAST(
            %(unit_count)s,
            GREATEST(0, %(daily_limit)s - locked.id_units_reserved)
        ) AS grant_n
        FROM locked
    )
    UPDATE radar_api_budget_daily AS d
    SET id_units_reserved = d.id_units_reserved + grant_calc.grant_n
    FROM grant_calc
    WHERE d.budget_kind = %(kind)s AND d.utc_day = %(day)s
    RETURNING d.id_units_reserved AS reserved_after, grant_calc.grant_n AS granted
    
