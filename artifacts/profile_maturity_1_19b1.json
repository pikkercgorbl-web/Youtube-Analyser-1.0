                COUNT(*) FILTER (
                    WHERE maturity_at > %(now_ts)s
                      AND maturity_at <= %(now_ts)s + (%(win48)s * INTERVAL '1 hour')
                )::int AS matures_next_48h
            FROM annotated
        
