        WITH
        video_owner AS (
            SELECT
                video_id,
                keyword_id,
                ROW_NUMBER() OVER (
                    PARTITION BY video_id
                    ORDER BY discovered_at ASC, keyword_id ASC
                ) AS owner_rn
            FROM keyword_discovery_hits
        ),
        owners AS (
            SELECT video_id, keyword_id
            FROM video_owner
            WHERE owner_rn = 1
        ),
        
    pair_first AS (
        SELECT
            id,
            keyword_id,
            video_id,
            discovered_at,
            views_at_discovery,
            ROW_NUMBER() OVER (
                PARTITION BY keyword_id, video_id
                ORDER BY discovered_at ASC, id ASC
            ) AS pair_rn
        FROM keyword_discovery_hits
    ),
    pair_baselines AS (
        SELECT keyword_id, video_id, discovered_at, views_at_discovery
        FROM pair_first
        WHERE pair_rn = 1
    )
,
        baselines AS (
            SELECT p.keyword_id, p.video_id, p.discovered_at, p.views_at_discovery
            FROM owners o
            INNER JOIN pair_baselines p
                ON p.video_id = o.video_id AND p.keyword_id = o.keyword_id
        ),
        annotated AS (
            SELECT
                keyword_id,
                video_id,
                discovered_at,
                views_at_discovery,
                discovered_at + (%(horizon_hours)s * INTERVAL '1 hour') AS maturity_at
            FROM baselines
        )
    
            SELECT
                COUNT(*)::int AS attributed,
                COUNT(*) FILTER (WHERE maturity_at > %(now_ts)s)::int AS pending,
                COUNT(*) FILTER (WHERE maturity_at <= %(now_ts)s)::int AS matured,
                COUNT(*) FILTER (
                    WHERE maturity_at > %(now_ts)s
                      AND maturity_at <= %(now_ts)s + (%(win6)s * INTERVAL '1 hour')
