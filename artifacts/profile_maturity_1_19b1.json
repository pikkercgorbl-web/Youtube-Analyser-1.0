            WITH 
    pair_first AS (
        SELECT
            id,
            keyword_id,
            video_id,
            discovered_at,
            views_at_discovery,
            ROW_NUMBER() OVER (
                PARTITION BY keyword_id, video_id
                ORDER BY discovered_at ASC, id ASC
            ) AS pair_rn
        FROM keyword_discovery_hits
    ),
    pair_baselines AS (
        SELECT keyword_id, video_id, discovered_at, views_at_discovery
        FROM pair_first
        WHERE pair_rn = 1
    )
,
            baselines AS (
                SELECT keyword_id, video_id, discovered_at, views_at_discovery
                FROM pair_baselines
            ),
            annotated AS (
                SELECT
                    keyword_id,
                    video_id,
                    discovered_at,
                    views_at_discovery,
                    discovered_at + (%(horizon_hours)s * INTERVAL '1 hour') AS maturity_at
                FROM baselines
            )
        
            SELECT
                COUNT(*)::int AS attributed,
                COUNT(*) FILTER (WHERE maturity_at > %(now_ts)s)::int AS pending,
                COUNT(*) FILTER (WHERE maturity_at <= %(now_ts)s)::int AS matured,
                COUNT(*) FILTER (
                    WHERE maturity_at > %(now_ts)s
                      AND maturity_at <= %(now_ts)s + (%(win6)s * INTERVAL '1 hour')
