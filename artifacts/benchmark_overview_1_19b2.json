            WITH 
    pair_first AS (
        SELECT
            id,
            keyword_id,
            video_id,
            discovered_at,
            views_at_discovery,
            ROW_NUMBER() OVER (
                PARTITION BY keyword_id, video_id
                ORDER BY discovered_at ASC, id ASC
            ) AS pair_rn
        FROM keyword_discovery_hits
    ),
    pair_baselines AS (
        SELECT keyword_id, video_id, discovered_at, views_at_discovery
        FROM pair_first
        WHERE pair_rn = 1
    )
,
            baselines AS (
                SELECT keyword_id, video_id, discovered_at, views_at_discovery
                FROM pair_baselines
            ),
            annotated AS (
                SELECT
                    keyword_id,
                    video_id,
                    discovered_at,
                    views_at_discovery,
                    discovered_at + (%(horizon_hours)s * INTERVAL '1 hour') AS maturity_at
                FROM baselines
            ),
        eligible AS (
            SELECT keyword_id, video_id, maturity_at
            FROM annotated
            WHERE maturity_at <= %(now_ts)s
              AND views_at_discovery IS NOT NULL
        ),
        ranked_snaps AS (
            SELECT
                e.keyword_id,
                e.video_id,
                ROW_NUMBER() OVER (
                    PARTITION BY e.keyword_id, e.video_id
                    ORDER BY ABS(EXTRACT(EPOCH FROM (s.captured_at - e.maturity_at))) ASC, s.captured_at ASC, s.id ASC
                ) AS snap_rn
            FROM eligible e
            INNER JOIN video_snapshots s
                ON s.video_id = e.video_id
               AND s.views IS NOT NULL
               
               AND s.captured_at >= e.maturity_at - (%(tolerance_hours)s * INTERVAL '1 hour')
               AND s.captured_at <= e.maturity_at + (%(tolerance_hours)s * INTERVAL '1 hour')
        
        ),
        matched AS (
            SELECT keyword_id, video_id
            FROM ranked_snaps
            WHERE snap_rn = 1
        )
        SELECT
            
            COUNT(*)::int AS attributed,
            COUNT(*) FILTER (WHERE maturity_at > %(now_ts)s)::int AS pending,
            COUNT(*) FILTER (WHERE maturity_at <= %(now_ts)s)::int AS matured,
            COUNT(*) FILTER (
                WHERE maturity_at > %(now_ts)s
                  AND maturity_at <= %(now_ts)s + (%(win6)s * INTERVAL '1 hour')
            )::int AS matures_next_6h,
            COUNT(*) FILTER (
                WHERE maturity_at > %(now_ts)s
                  AND maturity_at <= %(now_ts)s + (%(win24)s * INTERVAL '1 hour')
            )::int AS matures_next_24h,
            COUNT(*) FILTER (
                WHERE maturity_at > %(now_ts)s
                  AND maturity_at <= %(now_ts)s + (%(win48)s * INTERVAL '1 hour')
            )::int AS matures_next_48h
        ,
            (SELECT COUNT(*) FROM eligible) AS eligible_count,
            (SELECT COUNT(*) FROM matched) AS valid_count
        FROM annotated
    
