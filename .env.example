# Локально (без DATABASE_URL в окружении) — SQLite по умолчанию:
DATABASE_URL=sqlite:///./database.db
# Production: Supabase → Project Settings → Database → Connection string (URI)
# Render автоматически подставляет DATABASE_URL; ссылка может начинаться с postgres://
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
APP_NAME=YouTube Analytics
DEBUG=true
# Интервал фонового радара взрывных каналов (секунды, минимум 60; по умолчанию 5 мин):
# EXPLOSIVE_RADAR_INTERVAL_SECONDS=300
YOUTUBE_API_KEYS=
