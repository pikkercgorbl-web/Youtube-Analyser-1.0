# Локально (без DATABASE_URL в окружении) — SQLite по умолчанию:
DATABASE_URL=sqlite:///./database.db
# Hosted PostgreSQL (optional): set DATABASE_URL to your server URI (postgres:// → postgresql:// supported).
#
# Локальный Radar (Docker, см. docs/LOCAL_RADAR_LAPTOP.md):
# python scripts/configure_local_database_env.py
# DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5433/youtube_radar_restore_check
# RADAR_ENRICHMENT_AFTER_DISCOVERY=1
# Авто keyword expansion после цикла discovery (отдельная сессия; по умолчанию выключено):
# KEYWORD_EXPANSION_AFTER_DISCOVERY=1
# Topic exploration (широкие запросы вне seed; отдельная сессия; по умолчанию выключено):
# TOPIC_EXPLORATION_IN_DISCOVERY=1
# TOPIC_EXPLORATION_QUERIES_FILE=config/topic_exploration_queries.example.json
# TOPIC_EXPLORATION_BATCH_FRACTION=0.2
# TOPIC_EXPLORATION_MAX_PAGES_PER_QUERY=3
# TOPIC_EXPLORATION_AUTO_ADMIT=0
# Local enable record: artifacts/stage6_local_radar_enable.json
APP_NAME=YouTube Analytics
DEBUG=true
# Интервал фонового радара взрывных каналов (секунды, минимум 60; по умолчанию 5 мин):
# EXPLOSIVE_RADAR_INTERVAL_SECONDS=300
YOUTUBE_API_KEYS=
# Groq smoke test only (scripts/test_groq_access.py — not used by Radar yet):
# GROQ_API_KEY=
# Optional UTC start for Channel Momentum baseline (local continuous measurement):
# MOMENTUM_MEASUREMENT_START_UTC=2026-10-06T11:24:58+00:00
# Local Radar enrichment daily caps (ledger keeps prior reservations; raise limit to add headroom):
# CHANNEL_SUBSCRIBER_ENRICHMENT_DAILY_LIMIT=1000
# UNKNOWN_FORMAT_ENRICHMENT_DAILY_VIDEO_LIMIT=1000
# Per-pass caps (defaults 50 each): CHANNEL_SUBSCRIBER_ENRICHMENT_PASS_LIMIT, VIDEO_FORMAT_ENRICHMENT_PASS_LIMIT
# Share of each pass reserved for backlog candidates (remainder = cycle/recent): ENRICHMENT_BACKLOG_PASS_FRACTION=0.2
# FORMAT_ENRICHMENT_RETRY_AFTER_HOURS=6
# PostgreSQL concurrency tests: RADAR_BUDGET_POSTGRES_TEST_URL=postgresql://...@127.0.0.1:5433/youtube_radar_budget_test
