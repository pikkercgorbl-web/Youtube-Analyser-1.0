# Copy to .env.docker and set a strong RADAR_LOCAL_DB_PASSWORD.
# Used only by: docker compose --env-file .env.docker ...
# Does not affect backend/workers until you point DATABASE_URL at this instance.

RADAR_LOCAL_DB_NAME=youtube_radar
RADAR_LOCAL_DB_USER=radar
RADAR_LOCAL_DB_PASSWORD=

# Future app connection (host, not inside Compose network):
# DATABASE_URL=postgresql://radar:<password>@127.0.0.1:5433/youtube_radar
